# Database Configuration
# For Docker: uses 'db' container name
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/pdftoskill

# For local development (uncomment and use):
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/pdftoskill

# LLM API (Optional - for better answers)
# Get API key from https://platform.minimax.ai/
LLM_API_KEY=
LLM_API_BASE=https://api.minimax.chat/v1

# Embedding Model
# Local model (default, no setup needed - downloads automatically):
EMBED_MODEL_NAME=all-MiniLM-L6-v2

# OR use an API-based embedding model (uncomment and fill below):
# EMBED_MODEL_NAME=text-embedding-3-small
# EMBED_API_KEY=your_api_key_here
# EMBED_API_BASE=https://api.openai.com/v1